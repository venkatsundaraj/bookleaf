# Postgres connection string (managed/cloud Postgres in production)
DATABASE_URL=postgres://user:password@host:5432/bookleaf

# Long random string used to sign the session JWT
AUTH_SECRET=change-me

# OpenAI. Never exposed to the browser; only the server reads it.
OPENAI_API_KEY=sk-...
# Optional model overrides (default gpt-4o-mini)
OPENAI_CLASSIFY_MODEL=gpt-4o-mini
OPENAI_DRAFT_MODEL=gpt-4o-mini

NODE_ENV=development
PORT=8000
