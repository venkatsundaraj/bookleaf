{
  // Type-checking only: Node 24 runs the .ts files directly by stripping types,
  // so tsc never emits JavaScript here.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Imports use explicit ".ts" paths, which Node's loader requires.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Reject TS-only runtime syntax (enums, namespaces with code) that
    // Node's type stripping can't run, and keep type imports explicit.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "app/**/*.ts", "drizzle.config.ts"]
}
